{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Stock": "Data Source=stock.db"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Seed": {
    "Enabled": true,
    "SkusPerWarehouse": 250,
    "RandomSeed": 42
  },
  "Reservations": {
    "DefaultHoldMinutes": 30,
    "MaxHoldMinutes": 240,
    "MaxLinesPerReservation": 50,
    "MaxConcurrencyRetries": 8
  },
  "Workers": {
    "Enabled": true,
    "ExpirySweepSeconds": 15,
    "OutboxPollSeconds": 2,
    "BatchSize": 100,
    "OutboxMaxAttempts": 6,
    "OutboxBaseRetrySeconds": 5
  },
  "RateLimits": {
    "WritesPerMinute": 120,
    "AuthPerMinute": 10
  },
  "Jwt": {
    "Issuer": "stock-reservation",
    "Audience": "stock-reservation-clients",
    "SigningKey": "local-development-only-signing-key-override-with-Jwt__SigningKey",
    "TokenMinutes": 60
  },
