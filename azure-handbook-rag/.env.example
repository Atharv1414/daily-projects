# No API keys: the app signs in with `az login` (or a managed identity when hosted).
PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project>
OPENAI_ENDPOINT=https://<foundry-resource>.openai.azure.com/openai/v1/
SEARCH_ENDPOINT=https://<search-service>.search.windows.net
SEARCH_INDEX=handbook
# These are deployment names, not model names.
CHAT_DEPLOYMENT=chat
EMBEDDING_DEPLOYMENT=embedding
EMBEDDING_DIMENSIONS=1536
# Semantic reranking. Set to false if your search service does not offer it.
USE_SEMANTIC=true
# Reranker scores run 0-4. Chunks below this are dropped (semantic mode only).
MIN_RERANKER_SCORE=1.5
